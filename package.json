{
  "name": "anunciacao",
  "version": "2.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c cyan,green \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "web": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux",
    "icons": "node scripts/make-icons.mjs",
    "install:mac": "sh scripts/install-mac.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "sip.js": "^0.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4",
    "vite": "^5.4.21",
    "wait-on": "^9.1.0"
  },
  "productName": "Vincii Anunciacao",
  "description": "Vincii Anunciação — Cliente VoIP da Vincii",
  "author": "VINCII <contato@vincii.com.br>",
  "main": "electron/main.js",
  "build": {
    "appId": "br.com.vincii.anunciacao",
    "productName": "Vincii Anunciacao",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "SIP",
        "schemes": [
          "sip",
          "tel",
          "callto"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Vincii Anunciação usa o microfone para as chamadas de voz.",
        "CFBundleDisplayName": "Vincii Anunciação"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "Vincii Anunciacao"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Vincii Anunciação",
      "uninstallDisplayName": "Vincii Anunciação"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;Telephony",
      "mimeTypes": [
        "x-scheme-handler/sip",
        "x-scheme-handler/tel",
        "x-scheme-handler/callto"
      ],
      "maintainer": "VINCII <contato@vincii.com.br>",
      "executableName": "anunciacao",
      "desktop": {
        "entry": {
          "Name": "Vincii Anunciação",
          "Comment": "Cliente VoIP da Vincii"
        }
      }
    },
    "artifactName": "Vincii-Anunciacao-${version}-${os}-${arch}.${ext}",
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Vincii-Solucoes/vincii-anunciacao.git"
  },
  "homepage": "https://vincii.com.br",
  "license": "GPL-3.0-or-later"
}
